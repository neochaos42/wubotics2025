<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <origin xyz="0.305 0 0.08" rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>


    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_link_optical"></link>



<gazebo reference="camera_link">
    <material>Gazebo/Red</material>

    <sensor name="camera" type="depth">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>30</update_rate> <!-- Increased update rate for better real-time performance -->
        <camera>
            <!-- The D450 has a horizontal FOV of about 87 degrees, which is approximately 1.52 radians -->
            <horizontal_fov>1.52</horizontal_fov>
            <image>
                <format>B8G8R8</format>
                <width>1280</width> <!-- Higher resolution for D450 -->
                <height>720</height>
            </image>
            <clip>
                <near>0.11</near> <!-- Adjusting near clip based on D450 minimum depth distance -->
                <far>10.0</far> <!-- Typical maximum range for the D450 depth sensor -->
            </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <frame_name>camera_link_optical</frame_name>
            <min_depth>0.1</min_depth> <!-- Minimum depth sensing limit for the D450 -->
            <max_depth>10.0</max_depth> <!-- Maximum depth sensing limit for the D450 -->
        </plugin>
    </sensor>
</gazebo>


</robot>